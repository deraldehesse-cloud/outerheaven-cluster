{
  "id": "video_generation",
  "name": "Video Generation (AnimateDiff)",
  "description": "Erstellt fl\u00fcssige Video-Animationen und Looping-GIFs via Checkpoint, AnimateDiff Motion Model und Frame-Kombinierung",
  "icon": "\ud83c\udfac",
  "category": "animation",
  "steps": [
    {
      "id": "step_1",
      "node_type": "CheckpointLoaderSimple",
      "title": "Checkpoint Loader",
      "category": "loaders",
      "params": {
        "ckpt_name": "DreamShaper8_LCM.safetensors"
      }
    },
    {
      "id": "step_2",
      "node_type": "AnimateDiffLoaderWithContext",
      "title": "AnimateDiff Motion Module",
      "category": "AnimateDiff",
      "params": {
        "model_name": "mm_sd_v15_v2.ckpt",
        "beta_schedule": "sqrt_linear (AnimateDiff)"
      }
    },
    {
      "id": "step_3",
      "node_type": "EmptyLatentImage",
      "title": "Latent Batch (16 Frames)",
      "category": "latent",
      "params": {
        "width": 512,
        "height": 512,
        "batch_size": 16
      }
    },
    {
      "id": "step_4",
      "node_type": "CLIPTextEncode",
      "title": "CLIP Text (Positive)",
      "category": "conditioning",
      "role": "positive_prompt",
      "params": {
        "text": "tactical cyborg walking in dark neon rain, cinematic animation, glowing cybernetic armor, fluid motion"
      }
    },
    {
      "id": "step_5",
      "node_type": "CLIPTextEncode",
      "title": "CLIP Text (Negative)",
      "category": "conditioning",
      "role": "negative_prompt",
      "params": {
        "text": "ugly, deformed, bad anatomy, blurry, static frame, watermark"
      }
    },
    {
      "id": "step_6",
      "node_type": "KSampler",
      "title": "KSampler Motion Engine",
      "category": "sampling",
      "params": {
        "seed": 0,
        "steps": 16,
        "cfg": 7.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0
      }
    },
    {
      "id": "step_7",
      "node_type": "VAEDecode",
      "title": "VAE Decode Frames",
      "category": "latent",
      "params": {}
    },
    {
      "id": "step_8",
      "node_type": "AnimateDiffCombine",
      "title": "AnimateDiff Video Combine",
      "category": "AnimateDiff",
      "params": {
        "frame_rate": 8,
        "loop_count": 0,
        "filename_prefix": "OuterHeaven_Motion",
        "format": "image/gif",
        "pingpong": false
      }
    }
  ],
  "connections": [
    {
      "from_node": "step_1",
      "output_name": "MODEL",
      "output_type": "MODEL",
      "to_node": "step_2",
      "input_name": "model",
      "input_type": "MODEL"
    },
    {
      "from_node": "step_2",
      "output_name": "MODEL",
      "output_type": "MODEL",
      "to_node": "step_6",
      "input_name": "model",
      "input_type": "MODEL"
    },
    {
      "from_node": "step_1",
      "output_name": "CLIP",
      "output_type": "CLIP",
      "to_node": "step_4",
      "input_name": "clip",
      "input_type": "CLIP"
    },
    {
      "from_node": "step_1",
      "output_name": "CLIP",
      "output_type": "CLIP",
      "to_node": "step_5",
      "input_name": "clip",
      "input_type": "CLIP"
    },
    {
      "from_node": "step_4",
      "output_name": "CONDITIONING",
      "output_type": "CONDITIONING",
      "to_node": "step_6",
      "input_name": "positive",
      "input_type": "CONDITIONING"
    },
    {
      "from_node": "step_5",
      "output_name": "CONDITIONING",
      "output_type": "CONDITIONING",
      "to_node": "step_6",
      "input_name": "negative",
      "input_type": "CONDITIONING"
    },
    {
      "from_node": "step_3",
      "output_name": "LATENT",
      "output_type": "LATENT",
      "to_node": "step_6",
      "input_name": "latent_image",
      "input_type": "LATENT"
    },
    {
      "from_node": "step_6",
      "output_name": "LATENT",
      "output_type": "LATENT",
      "to_node": "step_7",
      "input_name": "samples",
      "input_type": "LATENT"
    },
    {
      "from_node": "step_1",
      "output_name": "VAE",
      "output_type": "VAE",
      "to_node": "step_7",
      "input_name": "vae",
      "input_type": "VAE"
    },
    {
      "from_node": "step_7",
      "output_name": "IMAGE",
      "output_type": "IMAGE",
      "to_node": "step_8",
      "input_name": "images",
      "input_type": "IMAGE"
    }
  ]
}