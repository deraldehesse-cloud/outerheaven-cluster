[Unit]
Description=Fox Research Agent - Fashion & Slang Research Service
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/fox/scripts
ExecStart=/home/fox/.hermes/.venv/bin/python /home/fox/scripts/fox_research_agent.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PORT=5005
Environment=HOST=0.0.0.0
Environment=OLLAMA_MODEL=hermes-3-3b-q8:latest
Environment=OLLAMA_URL=http://127.0.0.1:11434

[Install]
WantedBy=default.target
