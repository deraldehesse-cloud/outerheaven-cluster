[Unit]
Description=Hermes Invoice Processor Service
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/storage-beta
Environment="PATH=/home/outerheaven/.hermes/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/outerheaven/.hermes/.venv/bin/python /home/outerheaven/scripts/buero/invoice_processor.py --once
StandardOutput=journal
StandardError=journal
