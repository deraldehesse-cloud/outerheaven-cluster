# ==============================================================================
# Outer Heaven Cluster - Git Ignore Policy
# ==============================================================================

# Private Projekte, Notizen und Prompts
projekte/
projects/
prompts/
chat_logs/
*.md
!README.md
.cursor_tasks.md
.cursor_task.md

# Secrets, Zertifikate und Keys
*.key
*.pem
*.env
*.env.*
!*.env.example
secrets/
credentials/
*.token

# JSON Secrets & Service Accounts
*.json
!manifest.json
!package.json
!workflows/*.json
!workflows/archetypes/*.json
!mission-control/workflows/archetypes/*.json

# Generierte Medien und Modelle
output/
downloads/
cache/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.safetensors
*.ckpt
*.pt
*.bin

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Logs and Backups
*.log
*.bak
*.tmp
*.swp
*.old

# OS artifacts
.DS_Store
Thumbs.db

